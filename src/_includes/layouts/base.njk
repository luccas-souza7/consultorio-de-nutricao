{%- set tituloPagina = (seo_titulo or title) -%}
{%- set tituloCompleto = tituloPagina + " | " + site.nome + " (projeto fictício)" if not tituloHome else tituloHome -%}
{%- set descricao = (seo_descricao or description or site.descricao) -%}
{%- set urlCanonica = page.url | absUrl -%}
{%- set imagemOg = (capa | absUrl) if capa else (siteUrl + "/assets/img/og-image.jpg") -%}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ tituloCompleto }}</title>
  <meta name="description" content="{{ descricao }}">
  <meta name="theme-color" content="#2F4F3A">
  <meta name="author" content="Luccas Souza">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="canonical" href="{{ urlCanonica }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="Blog {{ site.nome }}" href="/feed.xml">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="{{ site.nome }} (projeto fictício)">
  <meta property="og:title" content="{{ tituloPagina }}">
  <meta property="og:description" content="{{ descricao }}">
  <meta property="og:url" content="{{ urlCanonica }}">
  <meta property="og:image" content="{{ imagemOg }}">
  <meta property="og:image:alt" content="{{ capa_alt or ('Página do site ' + site.nome) }}">
  {%- if ogType == "article" %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preload" href="/assets/fonts/fraunces-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  {%- if cssExtra %}
  <link rel="stylesheet" href="{{ cssExtra }}">
  {%- endif %}
  <script>(function(d){d.classList.add("js");if(!matchMedia("(prefers-reduced-motion: reduce)").matches){d.classList.add("anim");setTimeout(function(){if(!d.classList.contains("anim-ok"))d.classList.remove("anim")},3500)}})(document.documentElement);</script>
  <script type="application/ld+json">{{ site | websiteLd | safe }}</script>
  {%- if jsonld %}
  <script type="application/ld+json">{{ jsonld | json | safe }}</script>
  {%- endif %}
  <script type="module" src="/assets/js/main.js"></script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  {% include "partials/header.njk" %}
  <main id="conteudo" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/extras.njk" %}
</body>
</html>
