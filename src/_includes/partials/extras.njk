<section class="cookie" id="cookie-banner" aria-labelledby="cookie-titulo" hidden>
  <h2 class="cookie__title" id="cookie-titulo">{% icon "cookie" %} Sua privacidade</h2>
  <p class="cookie__text">Usamos apenas o armazenamento local do navegador para lembrar a sua escolha sobre este aviso. Não há cookies de rastreamento nem de publicidade.</p>
  <div class="cookie__actions">
    <button class="btn btn--sm" type="button" data-cookie="aceito">Aceitar</button>
    <button class="btn btn--sm btn--outline" type="button" data-cookie="recusado">Recusar</button>
    <a href="/politica-de-cookies/">Saiba mais</a>
  </div>
</section>
