{%- set nav = [
  { id: "inicio", rotulo: "Início", url: "/" },
  { id: "sobre", rotulo: "Sobre", url: "/#sobre" },
  { id: "servicos", rotulo: "Serviços", url: "/#servicos" },
  { id: "planos", rotulo: "Planos", url: "/#planos" },
  { id: "blog", rotulo: "Blog", url: "/blog/" },
  { id: "contato", rotulo: "Contato", url: "/#contato" }
] -%}
<header class="header" data-header>
  <div class="container header__inner">
    <a class="logo" href="/" aria-label="{{ site.nome }}, página inicial">
      <img class="logo__mark" src="/assets/img/logo-marca.svg" alt="" width="40" height="40" eleventy:ignore>
      <span class="logo__text" aria-hidden="true"><span class="logo__name">{{ site.nomeCurto }}</span><span class="logo__sub">Nutrição</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu-principal" aria-label="Abrir menu">
      <span class="nav-toggle__bar"></span><span class="nav-toggle__bar"></span><span class="nav-toggle__bar"></span>
    </button>
    <nav class="nav" id="menu-principal" aria-label="Menu principal">
      <ul class="nav__list">
        {%- for item in nav %}
        <li><a class="nav__link{% if navAtivo == item.id %} is-active{% endif %}" href="{{ item.url }}"{% if navAtivo == item.id %} aria-current="page"{% endif %} data-nav="{{ item.id }}"><span class="nav__label"><span class="nav__label-in">{{ item.rotulo }}</span></span></a></li>
        {%- endfor %}
      </ul>
      <a class="btn btn--block nav__cta-mobile" href="{{ site.mensagens.agendar | wa }}" target="_blank" rel="noopener">{% icon "whatsapp" %} Agendar pelo WhatsApp<span class="sr-only"> (abre em nova aba)</span></a>
    </nav>
    <a class="btn btn--sm header__cta" href="{{ site.mensagens.agendar | wa }}" target="_blank" rel="noopener" data-magnetic><span class="btn__fill" aria-hidden="true"></span><span class="btn__label">{% icon "whatsapp" %} Agendar consulta</span><span class="sr-only"> pelo WhatsApp (abre em nova aba)</span></a>
  </div>
</header>
